# ============================================================
# Tauri + Python Sidecar 模板 — 环境变量配置
# ============================================================
# 使用方法：复制此文件为 .env（自动 gitignore），按本机环境填值。
# sidecar.py 启动时会自动加载 .env 和 .env.local（后者优先级高）。
# ============================================================

# 开发期 Python 解释器路径（tauri dev 回退 conda/venv 时定位 sidecar.py 用）。
# 打包后无需此变量（PyInstaller binary 自带 Python runtime）。
# 例：conda 环境 / Python venv 都可，指向能 import fastapi/uvicorn/sqlalchemy 的解释器。
SIDECAR_DEV_PYTHON=/path/to/your/python

# Sidecar 调试模式（开启后 /docs 接口可用）
# SIDECAR_DEBUG=1

# HTTP 代理（如使用本地代理）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
