# 用户数据（运行时生成）
*.db
*.db-journal
sidecar.pid

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
.venv/

# 构建产物
dist/
build/
!src-tauri/build/
!backend/build/
backend/build/*
!backend/build/*.spec

# 测试产物（pytest-cov 等）
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Tauri
src-tauri/target/
src-tauri/gen/

# IDE
.vscode/
.idea/
*.swp
*.swo
.zcode/

# 环境变量
.env
.env.local

# 打包产物
*.dmg
*.app
*.tsbuildinfo

# PyInstaller 产物（构建生成，不入 git，但保留目录结构）
resources/bin/*
!resources/bin/.gitkeep

# Git worktrees（多窗口并行开发隔离目录）
.worktrees/
